# ─────────────────────────── App ───────────────────────────
NODE_ENV=development
APP_NAME=costy

# Server (Express)
SERVER_PORT=4000
SERVER_HOST=0.0.0.0
SERVER_URL=http://localhost:4000

# Web (Next.js)
WEB_PORT=3000
WEB_URL=http://localhost:3000

# Admin (Next.js)
ADMIN_PORT=3001
ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001/api
# Express cho route proxy auth + `/api/v1` (mặc định http://localhost:4000).
# Web: `/api/auth/*` — Admin: `/api/admin/auth/*` (cookie prefix `costy-admin`).
UPSTREAM_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Must match seeded demo user (`pnpm db:seed`) until BetterAuth ships
NEXT_PUBLIC_DEMO_USER_ID=seed_demo_user_001

# ─────────────────────────── Database ───────────────────────
DATABASE_URL=postgresql://costy:matkhaucuaban@127.0.0.1:5432/costy?schema=public

# ─────────────────────────── Redis ──────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# ─────────────────────────── Auth (BetterAuth) ──────────────
BETTER_AUTH_SECRET=replace_with_64_char_random_string
# Web app public URL (OAuth redirects, web session `baseURL`). Same host as WEB_URL in dev.
BETTER_AUTH_URL=http://localhost:3000
# Admin session cookies use a separate prefix (default costy-admin). Optional override:
# AUTH_ADMIN_COOKIE_PREFIX=costy-admin

# Google OAuth (đăng nhập / đăng ký Gmail). Redirect URI trong Google Console:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Client ID công khai (hiện nút Google trên UI). Đặt cùng giá trị với GOOGLE_CLIENT_ID (Web application).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# ─────────────────────────── Cloudinary (signed client upload) ─
# Cloud name = Product environment settings (vd. dgj1kdgpd), KHÔNG phải tên cột "Key Name"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────── Email ──────────────────────────
# Gửi mail (Better Auth đặt lại mật khẩu). Local + Mailhog: HOST=localhost PORT=1025, để trống USER/PASS.
# Gmail: smtp.gmail.com:587 + SMTP_USER + Mật khẩu ứng dụng trong SMTP_PASS (không phải mật khẩu web).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@costy.local

# ─────────────────────────── Search (Vercel AI Gateway embeddings) ─
# Key tạo tại Vercel Dashboard → AI Gateway (prefix vck_)
AI_GATEWAY_API_KEY=

# ─────────────────────────── Misc ───────────────────────────
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_POINTS=500
RATE_LIMIT_DURATION=60
# Đặt true trên Docker local nếu vẫn gặp 429 (Better Auth rate limit).
AUTH_RATE_LIMIT_DISABLED=false

# ─────────────────────────── Demo seed accounts ─────────────
# 3 HR admin (hr1–hr3@costy.io.vn) + 2 web users (demo1–demo2@costy.io.vn)
# Mật khẩu lưu hash trong bảng account; giá trị dưới đây là plaintext để biết trước.
SEED_HR_PASSWORD=
SEED_DEMO_PASSWORD=

# ─────────────────────────── Report System ──────────────────
# Số reports bị dismissed trong ngày để gắn flag anti-abuse cho reporter
REPORT_ANTI_ABUSE_DAILY_LIMIT=20
# Số reports trên cùng 1 target để đánh priority cao trong queue
REPORT_AUTO_ESCALATE_THRESHOLD=5

# ─────────────────────────── AI Content Moderation ──────────
# Vercel AI Gateway (dùng chung cho embeddings + moderation)
AI_GATEWAY_API_KEY=
# Bật/tắt moderation (mặc định: bật nếu có AI_GATEWAY_API_KEY)
MODERATION_ENABLED=true
MODERATION_AI_MODEL=openai/gpt-4o-mini
# confidence >= AUTO_HIDE → ẩn bài ngay; >= REVIEW → đưa vào hàng đợi admin
MODERATION_AUTO_HIDE_THRESHOLD=0.9
MODERATION_REVIEW_THRESHOLD=0.6
